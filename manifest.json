{
  "manifest_version": 3,
  "name": "TabSum: Inactive Tab Summarizer & Knowledge Wiki",
  "version": "1.0.0",
  "description": "Automatically summarizes neglected tabs and archives them into an in-browser knowledge wiki with 1-click restore.",
  "minimum_chrome_version": "126",
  "icons": {
    "16": "src/assets/icons/icon-16.png",
    "48": "src/assets/icons/icon-48.png",
    "128": "src/assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "TabSum: Knowledge Hub",
    "default_icon": {
      "16": "src/assets/icons/icon-16.png",
      "48": "src/assets/icons/icon-48.png",
      "128": "src/assets/icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open Side Panel / Knowledge Hub"
    },
    "archive_active_tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Archive and summarize active tab"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/app/index.html"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "idle",
    "scripting",
    "sidePanel",
    "unlimitedStorage",
    "notifications",
    "favicon"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
